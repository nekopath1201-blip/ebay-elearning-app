# Neon等のPostgreSQL接続文字列
DATABASE_URL=""

# `openssl rand -base64 32` などで生成した値に変更すること
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# S3互換ストレージ（AWS S3 または Cloudflare R2 等）
# 未設定の場合、動画・ファイルのアップロード機能はエラーを返す
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# R2等S3互換サービスを使う場合のみ設定（AWS S3の場合は空でよい）
S3_ENDPOINT=""
# R2の「Public Development URL」など、アップロードしたファイルに一般公開でアクセスできるURLのベース
# （例: https://pub-xxxxxxxx.r2.dev）。設定しない場合、S3_ENDPOINTから組み立てるが、
# R2のS3 APIエンドポイントは非公開のため、R2利用時は必ず設定すること。
S3_PUBLIC_URL=""
